---
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogPost from "../components/BlogPost.astro";
const allPosts = Object.values(import.meta.glob('./posts/*.md', { eager: true }));
const pageTitle = "Blog"
---

<BaseLayout pageTitle={pageTitle}>
	<p>hm, this is almost identical to my own portfolio, that's also going to have a blog section, obviously..</p>

    <p>Here we go, there's a list of my posts already:</p>
    <ul>
        {allPosts.map((post: any) => <BlogPost url={post.url} title={post.frontmatter.title} />)}
    </ul>
</BaseLayout>