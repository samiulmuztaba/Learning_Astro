---
import BaseLayout from '../layouts/BaseLayout.astro';
const pageTitle = "About Me";

const me = {
    firstName: "Samiul",
    country: "Bangladesh",
    profession: "programmer",
    grade: "10",
    hobbies: ["reading", "coding", "speedcubing", "chess"]
}

const skills = ["HTML", "CSS", "JS", "React","Python", "FastAPI", "Astro", "Supabase"]
const skillColor = "cornflowerblue"
const fontWeight = "bold"
const textCase = "capitalize"
---

<BaseLayout pageTitle={pageTitle}>
    <style define:vars={{skillColor, fontWeight, textCase}}>
        .skill {
            color: var(--skillColor);
            font-weight: var(--fontWeight);
            text-transform: var(--textCase);
        }
    </style>
	<p>Hi there, I am {me.firstName}, a {me.grade}th {me.profession} living in {me.country}. </p>
    {me.hobbies.length >= 3 && 
        <p>My main two hobbies are {me.hobbies[0]} and {me.hobbies[1]}, while I also like {me.hobbies[2]}.</p>
    }
    <p>My skills are:</p>
    <ul>
        {skills.map((skill) => <li class="skill">{skill}</li>)}
    </ul>
</BaseLayout>